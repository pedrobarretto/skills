# Copy to wrangler.toml and replace every example.com with your zone.
#
#   cp wrangler.toml.example wrangler.toml
#
# wrangler.toml is gitignored so your domain and KV id stay out of the repo.

name = "plan-page"
main = "src/index.js"
compatibility_date = "2025-01-01"

# The apex serves the control plane; the wildcard serves the plans.
# Both need the zone's `*` DNS record to be proxied — see SETUP.md.
routes = [
  { pattern = "example.com/*", zone_name = "example.com" },
  { pattern = "*.example.com/*", zone_name = "example.com" },
]

[vars]
PLAN_DOMAIN = "example.com"

# id comes from: wrangler kv namespace create PLANS
[[kv_namespaces]]
binding = "PLANS"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# PUBLISH_TOKEN is a secret, not a var:
#   wrangler secret put PUBLISH_TOKEN
